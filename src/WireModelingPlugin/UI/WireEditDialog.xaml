<Window x:Class="WireModelingPlugin.UI.WireEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Wire Segment"
        Width="450" Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Edit Wire Segment" FontSize="16" FontWeight="Bold"/>
            <TextBlock x:Name="ElementIdText" Foreground="Gray" FontSize="11"/>
        </StackPanel>

        <!-- Properties -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Wire Type -->
                <Label Content="Wire Type" FontWeight="SemiBold"/>
                <ComboBox x:Name="WireTypeCombo" Margin="0,0,0,10"/>

                <!-- Wire Gauge -->
                <Label Content="Wire Gauge (AWG)" FontWeight="SemiBold"/>
                <ComboBox x:Name="GaugeCombo" Margin="0,0,0,10"/>

                <!-- Conductor Count -->
                <Label Content="Number of Conductors" FontWeight="SemiBold"/>
                <ComboBox x:Name="ConductorCountCombo" Margin="0,0,0,10">
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                </ComboBox>

                <!-- Ground Size -->
                <Label Content="Ground Size (AWG)" FontWeight="SemiBold"/>
                <ComboBox x:Name="GroundSizeCombo" Margin="0,0,0,10"/>

                <!-- Voltage Rating -->
                <Label Content="Voltage Rating" FontWeight="SemiBold"/>
                <ComboBox x:Name="VoltageRatingCombo" Margin="0,0,0,10">
                    <ComboBoxItem Content="300V"/>
                    <ComboBoxItem Content="600V" IsSelected="True"/>
                </ComboBox>

                <!-- Temperature Rating -->
                <Label Content="Temperature Rating" FontWeight="SemiBold"/>
                <ComboBox x:Name="TempRatingCombo" Margin="0,0,0,10">
                    <ComboBoxItem Content="60°C"/>
                    <ComboBoxItem Content="75°C" IsSelected="True"/>
                    <ComboBoxItem Content="90°C"/>
                </ComboBox>

                <!-- Current Specification -->
                <GroupBox Header="Current Specification" Margin="0,10,0,0">
                    <StackPanel Margin="5">
                        <TextBlock x:Name="SpecText" FontWeight="Bold"/>
                        <Rectangle x:Name="ColorPreview" Height="20" Margin="0,5,0,0"
                                   Stroke="Gray" StrokeThickness="1"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="OK" Width="80" Margin="0,0,10,0"
                    Click="OkButton_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="80"
                    Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
